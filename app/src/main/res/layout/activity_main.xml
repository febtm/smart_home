<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin"
    android:paddingBottom="@dimen/activity_vertical_margin"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:background="@drawable/main_background">

    <LinearLayout
        android:id="@+id/on_off_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="3">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="CONNECTION TOGGLE"
            android:textSize="20dp"
            android:textStyle="bold"
            android:id="@+id/on_off_header"
            android:layout_gravity="center_horizontal"
            android:textColor="#FFFFFF"/>

        <ToggleButton
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:id="@+id/on_off_button"
            android:background="@drawable/off"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:textOn=""
            android:textOff=""
            />

        <TextView
            android:id="@+id/on_off_text"
            android:layout_height="wrap_content"
            android:layout_width="wrap_content"
            android:text="OFF"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:textSize="18dp"
            android:textColor="#20bd66"
            />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/human_presence_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:orientation="vertical"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="HUMAN PRESENCE"
            android:textSize="20dp"
            android:textStyle="bold"
            android:id="@+id/human_presence_text"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:textColor="#FFFFFF"
            />

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/red"
            android:id="@+id/human_presence_image"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:text="FALSE"
            android:textStyle="bold"
            android:id="@+id/human_presence_status"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="10dp"
            android:textSize="18dp"
            android:textColor="#20bd66"
            />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/switches_view"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:orientation="vertical">

        <Switch
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MAIN SWITCH       "
            android:textStyle="bold"
            android:id="@+id/main_switch"
            android:thumb="@drawable/custom_thumb"
            android:track="@drawable/custom_track"
            android:textColor="#f8b334"
            android:textSize="20dp"
            android:checked="false"
            android:layout_alignTop="@+id/main_switch_indicator"
            android:layout_alignRight="@+id/device_switch"
            android:layout_alignEnd="@+id/device_switch" />

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:id="@+id/main_switch_indicator"
            android:layout_gravity="right"
            android:background="#dd2727"
            android:layout_above="@+id/device_switch_indicator"
            android:layout_alignLeft="@+id/device_switch_indicator"
            android:layout_alignStart="@+id/device_switch_indicator" />

        <Switch
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEVICE SWITCH     "
            android:id="@+id/device_switch"
            android:thumb="@drawable/custom_thumb"
            android:track="@drawable/custom_track"
            android:textStyle="bold"
            android:textSize="20dp"
            android:textColor="#f8b334"
            android:layout_alignParentBottom="true"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true" />

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:id="@+id/device_switch_indicator"
            android:layout_gravity="right"
            android:background="#dd2727"
            android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true" />

        />

    </RelativeLayout>

</LinearLayout>